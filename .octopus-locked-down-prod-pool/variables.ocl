variable "Project.WorkerPool" {
    type        = "WorkerPool"
    description = "Worker pool this project's gate-check step runs on. Default is dev-pool; Production-scoped value pins prod-pool. Read by the Production gate check step via its worker_pool_variable. Editing requires VariableEdit (not granted to Developer-Restricted)."

    value "dev-pool" {}

    value "prod-pool" {
        environment = ["production"]
    }
}

variable "Replicas" {
    value "3" {
        environment = ["production"]
        tenant_tag = ["tier/enterprise"]
    }

    value "2" {
        environment = ["production"]
        tenant_tag = ["tier/pro"]
    }

    value "1" {
        environment = ["production"]
        tenant_tag = ["tier/free"]
    }

    value "1" {
        environment = ["dev"]
    }
}

variable "Tier" {
    value "free" {
        tenant_tag = ["tier/free"]
    }

    value "pro" {
        tenant_tag = ["tier/pro"]
    }

    value "enterprise" {
        tenant_tag = ["tier/enterprise"]
    }
}

variable "Featured.Mood" {
    value "comedy" {
        tenant_tag = ["mood/comedy"]
    }

    value "silicon-valley" {
        tenant_tag = ["mood/silicon-valley"]
    }

    value "stoic" {
        tenant_tag = ["mood/stoic"]
    }
}

variable "Brand.Icon" {
    value "🃏" {
        tenant_tag = ["mood/comedy"]
    }

    value "🚀" {
        tenant_tag = ["mood/silicon-valley"]
    }

    value "🧘" {
        tenant_tag = ["mood/stoic"]
    }
}

variable "Brand.Color" {
    value "#F5C518" {
        tenant_tag = ["mood/comedy"]
    }

    value "#00B0FF" {
        tenant_tag = ["mood/silicon-valley"]
    }

    value "#7E57C2" {
        tenant_tag = ["mood/stoic"]
    }
}

variable "Branding.Watermark" {
    value "" {}

    value "FREE TIER" {
        tenant_tag = ["tier/free"]
    }
}

variable "Maintenance.Message" {
    value "" {
        prompt {
            description = "Customer-facing message shown on the maintenance overlay. Set by the maintenance-on runbook; deploys leave it empty."
            label = "Maintenance Message"
        }
    }
}

variable "PR.Number" {
    value "0" {
        prompt {
            description = "GitHub PR number — drives the preview namespace and ingress host (randomquotes-preview-pr-#{PR.Number}). Set by .github/workflows/preview-env.yml when firing the Spin up/Teardown preview runbooks."
            label = "PR Number"
            required = true
        }
    }
}

variable "PR.Branch" {
    value "feat/example" {
        prompt {
            description = "Source branch (e.g. feat/ephemeral-demo). Informational — used in labels and log messages."
            label = "PR Branch"
            required = true
        }
    }
}

variable "PR.HeadSha" {
    value "main" {
        prompt {
            description = "PR head SHA. Mainly for the announce-url log line — image lookup uses pr-#{PR.Number} as the tag."
            label = "PR Head SHA"
        }
    }
}