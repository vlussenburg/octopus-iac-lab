name = "k8s-tenanted-app"
description = "Deploy a tenanted Kubernetes workload: ConfigMap + Deployment + Service + Ingress, plus Argo CD image-tag update. The consuming project passes ConfigMapYaml (full ConfigMap manifest) so the app owns its own schema while the template stays app-agnostic."

parameter "AppName" {
    display_settings = {
        Octopus.ControlType = "SingleLineText"
    }
    help_text = "Used as the workload/service/ingress name and the `app` label."
    label = "Application name"
}

parameter "Platform" {
    display_settings = {
        Octopus.ControlType = "TargetTags"
    }
    help_text = "Target role(s) the workload step deploys to."
    label = "Platform target role"
}

parameter "Namespace" {
    display_settings = {
        Octopus.ControlType = "SingleLineText"
    }
    help_text = "K8s namespace. Auto-created if missing."
    label = "Namespace"
}

parameter "Host" {
    display_settings = {
        Octopus.ControlType = "SingleLineText"
    }
    help_text = "Ingress hostname (FQDN)."
    label = "Ingress host"
}

parameter "Replicas" {
    display_settings = {
        Octopus.ControlType = "SingleLineText"
    }
    help_text = "Replica count for the Deployment."
    label = "Replicas"
}

parameter "ContainerPort" {
    display_settings = {
        Octopus.ControlType = "SingleLineText"
    }
    help_text = "Container port the workload listens on. Service.targetPort matches this; Service.port is fixed at 80."
    label = "Container port"
}

parameter "Tenant" {
    display_settings = {
        Octopus.ControlType = "SingleLineText"
    }
    help_text = "Value for the tenant.octopus.com/tenant label."
    label = "Tenant label value"
}

parameter "Tier" {
    display_settings = {
        Octopus.ControlType = "SingleLineText"
    }
    help_text = "Value for the tenant.octopus.com/tier label."
    label = "Tier label value"
}

parameter "ConfigMapYaml" {
    display_settings = {
        Octopus.ControlType = "MultiLineText"
    }
    help_text = "Full ConfigMap manifest (apiVersion/kind/metadata/data) the template applies alongside the workload. The consuming project owns its config schema; the template just writes it."
    label = "ConfigMap YAML"
}

parameter "ConfigMapName" {
    display_settings = {
        Octopus.ControlType = "SingleLineText"
    }
    help_text = "Name of the ConfigMap declared in ConfigMapYaml — the Deployment's volume reference needs to match metadata.name."
    label = "ConfigMap name"
}

parameter "ConfigMapMountPath" {
    display_settings = {
        Octopus.ControlType = "SingleLineText"
    }
    help_text = "Absolute path inside the container where the ConfigMap key is mounted as a single file."
    label = "ConfigMap mount path"
}

parameter "ConfigMapSubPath" {
    display_settings = {
        Octopus.ControlType = "SingleLineText"
    }
    help_text = "Key in the ConfigMap to mount (volumeMount subPath)."
    label = "ConfigMap subPath"
}

parameter "AppImage" {
    display_settings = {
        Octopus.ControlType = "Package"
    }
    help_text = "Container image package for the workload AND for the Argo CD image-tag update. One parameter for both — so the auto-release-on-image trigger (which can only resolve one package per fire) doesn't fail with 'no version specified' on the second action."
    label = "App image package"
}

step "deploy-manifests" {
    name = "Deploy Manifests"
    properties = {
        Octopus.Action.TargetRoles = "#{Platform}"
    }

    action {
        action_type = "Octopus.KubernetesDeployRawYaml"
        properties = {
            Octopus.Action.Kubernetes.DeploymentTimeout = "180"
            Octopus.Action.Kubernetes.ResourceStatusCheck = "False"
            Octopus.Action.Kubernetes.ServerSideApply.Enabled = "True"
            Octopus.Action.Kubernetes.ServerSideApply.ForceConflicts = "True"
            Octopus.Action.KubernetesContainers.AutoCreateNamespace = "True"
            Octopus.Action.KubernetesContainers.CustomResourceYaml = <<-EOT
                #{ConfigMapYaml}
                ---
                apiVersion: apps/v1
                kind: Deployment
                metadata:
                  name: #{AppName}
                  labels:
                    app: #{AppName}
                    tenant.octopus.com/tenant: "#{Tenant}"
                    tenant.octopus.com/tier: "#{Tier}"
                spec:
                  replicas: #{Replicas}
                  selector:
                    matchLabels:
                      app: #{AppName}
                  template:
                    metadata:
                      labels:
                        app: #{AppName}
                        tenant.octopus.com/tenant: "#{Tenant}"
                        tenant.octopus.com/tier: "#{Tier}"
                    spec:
                      containers:
                        - name: #{AppName}
                          image: #{Octopus.Action.Package[AppImage].Image}
                          ports:
                            - containerPort: #{ContainerPort}
                          resources:
                            requests: { cpu: "100m", memory: "64Mi" }
                            limits:   { cpu: "250m", memory: "128Mi" }
                          volumeMounts:
                            - name: config
                              mountPath: #{ConfigMapMountPath}
                              subPath: #{ConfigMapSubPath}
                      volumes:
                        - name: config
                          configMap:
                            name: #{ConfigMapName}
                ---
                apiVersion: v1
                kind: Service
                metadata: { name: #{AppName} }
                spec:
                  type: ClusterIP
                  selector: { app: #{AppName} }
                  ports:
                    - protocol: TCP
                      port: 80
                      targetPort: #{ContainerPort}
                ---
                apiVersion: networking.k8s.io/v1
                kind: Ingress
                metadata: { name: #{AppName} }
                spec:
                  ingressClassName: nginx
                  rules:
                    - host: #{Host}
                      http:
                        paths:
                          - path: /
                            pathType: Prefix
                            backend:
                              service:
                                name: #{AppName}
                                port: { number: 80 }
                EOT
            Octopus.Action.KubernetesContainers.DeploymentWait = "NoWait"
            Octopus.Action.KubernetesContainers.Namespace = "#{Namespace}"
            Octopus.Action.Script.ScriptSource = "Inline"
        }
        worker_pool_variable = ""

        packages "AppImage" {
            acquisition_location = "NotAcquired"
            properties = {
                Extract = "False"
                PackageParameterName = "AppImage"
                Purpose = "DockerImageReference"
                SelectionMode = "deferred"
            }
        }
    }
}

step "capture-deployment-artifacts" {
    name = "Capture deployment artifacts"
    properties = {
        Octopus.Action.TargetRoles = "#{Platform}"
    }

    action {
        action_type = "Octopus.KubernetesRunScript"
        properties = {
            Octopus.Action.KubernetesContainers.Namespace = "#{Namespace}"
            Octopus.Action.RunOnServer = "false"
            Octopus.Action.Script.ScriptSource = "Inline"
            Octopus.Action.Script.Syntax = "Bash"
            Octopus.Action.Script.ScriptBody = <<-EOT
                set -euo pipefail
                kubectl describe deployment #{AppName} > app-describe.txt
                new_octopusartifact app-describe.txt "describe-#{Octopus.Environment.Name}-#{Octopus.Deployment.Tenant.Name}.txt"
                kubectl get deployment,svc,ingress,configmap,pod -l app=#{AppName} -o yaml > app-resources.yaml
                new_octopusartifact app-resources.yaml "resources-#{Octopus.Environment.Name}-#{Octopus.Deployment.Tenant.Name}.yaml"
            EOT
        }
        worker_pool_variable = ""
    }
}

step "update-argo-cd-application-image-tags" {
    name = "Update Argo CD Application Image Tags"

    action {
        action_type = "Octopus.ArgoCDUpdateImageTags"
        properties = {
            Octopus.Action.ArgoCD.CommitMessageSummary = "Octopus Deploy updated image versions"
            Octopus.Action.ArgoCD.CommitMethod = "DirectCommit"
            Octopus.Action.ArgoCD.StepVerification.Method = "ArgoCDApplicationHealthy"
            Octopus.Action.ArgoCD.Sync.Mode = "AllEnvironments"
        }

        packages "AppImage" {
            acquisition_location = "NotAcquired"
            properties = {
                Extract = "False"
                PackageParameterName = "AppImage"
                Purpose = "DockerImageReference"
                SelectionMode = "deferred"
            }
        }
    }
}