variable "Project.WorkerPool" {
    type = "WorkerPool"

    value "prod-pool" {
        environment = ["production"]
    }
}

variable "Replicas" {
    value "3" {
        environment = ["production"]
        tenant_tag = ["tier/enterprise"]
    }

    value "2" {
        environment = ["production"]
        tenant_tag = ["tier/pro"]
    }

    value "1" {
        environment = ["production"]
        tenant_tag = ["tier/free"]
    }

    value "1" {
        environment = ["dev"]
    }

    value "1" {
        channel = ["ephemeral-previews"]
    }
}

variable "Tier" {
    value "free" {
        tenant_tag = ["tier/free"]
    }

    value "pro" {
        tenant_tag = ["tier/pro"]
    }

    value "enterprise" {
        tenant_tag = ["tier/enterprise"]
    }

    value "preview" {
        channel = ["ephemeral-previews"]
    }
}

variable "Featured.Mood" {
    value "comedy" {
        tenant_tag = ["mood/comedy"]
    }

    value "comedy" {
        channel = ["ephemeral-previews"]
    }

    value "silicon-valley" {
        tenant_tag = ["mood/silicon-valley"]
    }

    value "stoic" {
        tenant_tag = ["mood/stoic"]
    }
}

variable "Brand.Icon" {
    value "🃏" {
        tenant_tag = ["mood/comedy"]
    }

    value "🚀" {
        tenant_tag = ["mood/silicon-valley"]
    }

    value "🧘" {
        tenant_tag = ["mood/stoic"]
    }

    value "🚧" {
        channel = ["ephemeral-previews"]
    }
}

variable "Brand.Color" {
    value "#F5C518" {
        tenant_tag = ["mood/comedy"]
    }

    value "#00B0FF" {
        tenant_tag = ["mood/silicon-valley"]
    }

    value "#7E57C2" {
        tenant_tag = ["mood/stoic"]
    }

    value "#FF6B35" {
        channel = ["ephemeral-previews"]
    }
}

variable "Branding.Watermark" {
    value "" {}

    value "FREE TIER" {
        tenant_tag = ["tier/free"]
    }

    value "PREVIEW · #{Octopus.Environment.Name | Replace \"^preview-\" \"\"}" {
        channel = ["ephemeral-previews"]
    }
}

variable "K8s.Namespace" {
    value "randomquotes-#{Source}-#{Octopus.Deployment.Tenant.Name}-#{Octopus.Environment.Name | ToLower}" {}

    value "randomquotes-#{Octopus.Environment.Name}" {
        channel = ["ephemeral-previews"]
    }
}

variable "App.Host" {
    value "#{Source}-#{Octopus.Deployment.Tenant.Name}-#{Octopus.Environment.Name | ToLower}.localtest.me" {}

    value "octopus-randomquotes-#{Octopus.Environment.Name}.localtest.me" {
        channel = ["ephemeral-previews"]
    }
}

variable "App.Tenant" {
    value "#{Octopus.Deployment.Tenant.Name}" {}

    value "preview-inc" {
        channel = ["ephemeral-previews"]
    }
}

variable "Maintenance.Message" {
    value "" {
        prompt {
            description = "Customer-facing message shown on the maintenance overlay. Set by the maintenance-on runbook; deploys leave it empty."
            label = "Maintenance Message"
        }
    }
}